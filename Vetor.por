programa {
  funcao inicio() {
    // Vetor com 5 posições: indices 0, 1, 2, 3 e 4
    inteiro numero[5]

    numero[0] = 10 // primeira posição
    numero[1] = 20 // segunda posição
    numero[2] = 30 // terceira posição
    numero[3] = 40 // quarta posição
    numero[4] = 50 // quinta posição (ultima)

    escreva(numero[0], "\n")
    escreva(numero[1], "\n")
    escreva(numero[2], "\n")
    escreva(numero[3], "\n") 
    escreva(numero[4], "\n") 
  }
}
