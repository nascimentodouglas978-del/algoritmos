programa {
  funcao inicio() {
    inteiro notas[5]
    real altura[10]
    cadeia nomes[3]
    logico respostas[4]

    nomes[0] = "Ana"
    nomes[1] = "Bruno"
    nomes[2] = "carla"

    notas[0] = 7
    notas[1] = 9
    notas[2] = 2
    notas[3] = 6
    notas[4] = 3

    altura[0] = 1.89
    altura[1] = 1.70
    altura[2] = 1.40
    altura[3] = 1.30
    altura[4] = 1.20
    altura[5] = 1.60
    altura[6] = 1.90
    altura[7] = 2.00
    altura[8] = 5.00
    altura[9] = 9.00

    respostas[0] = verdadeiro
    respostas[1] = falso
    respostas[2] = verdadeiro
    respostas[3] = falso

    escreva(notas[0], "\n")
    escreva(notas[1], "\n")
    escreva(notas[2], "\n")
    escreva(notas[3], "\n")
    escreva(notas[4], "\n")

    escreva(altura[0], "\n")
    escreva(altura[1], "\n")
    escreva(altura[2], "\n")
    escreva(altura[3], "\n")
    escreva(altura[4], "\n")
    escreva(altura[5], "\n")
    escreva(altura[6], "\n")
    escreva(altura[7], "\n")
    escreva(altura[8], "\n")
    escreva(altura[9], "\n")

    escreva(nomes[0], "\n")
    escreva(nomes[1], "\n")
    escreva(nomes[2], "\n")

    escreva(respostas[0], "\n")
    escreva(respostas[1], "\n")
    escreva(respostas[2], "\n")
    escreva(respostas[3], "\n")
  }
}
